@page
@model GalleryModel
@* <link rel="stylesheet" href="~/css/Gallery.css" /> *@

<section class="wedding-gallery">
    <header class="gallery-header">
        <span class="gallery-subtitle">Våra minnen</span>
        <h1>Bröllopsgalleri</h1>
        <p>En samling ögonblick från vår speciella dag.</p>
    </header>

    <div class="gallery-grid">
        <figure class="gallery-item gallery-item-large">
            <img src="/images/photo1.jpg" alt="Bröllopsfoto 1" />
        </figure>

        <figure class="gallery-item">
            <img src="/images/photo2.jpg" alt="Bröllopsfoto 2" />
        </figure>

        <figure class="gallery-item">
            <img src="/images/photo3.jpg" alt="Bröllopsfoto 3" />
        </figure>

        <figure class="gallery-item">
            <img src="/images/photo4.jpg" alt="Bröllopsfoto 4" />
        </figure>

        <figure class="gallery-item gallery-item-tall">
            <img src="/images/photo5.jpg" alt="Bröllopsfoto 5" />
        </figure>

        <figure class="gallery-item">
            <img src="/images/bphoto1.jpg" alt="Bröllopsfoto 6" />
        </figure>

        <figure class="gallery-item">
            <img src="/images/bphoto2.jpg" alt="Bröllopsfoto 7" />
        </figure>

        <figure class="gallery-item gallery-item-wide">
            <img src="/images/bphoto3.jpg" alt="Bröllopsfoto 8" />
        </figure>
    </div>
</section>
<form method="get" action="/">
    <button type="submit" class="confirmation-button">
        Start ♡
    </button>
</form>