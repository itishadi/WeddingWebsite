@page
@model IndexModel

@{
    ViewData["Title"] = "Vårt bröllop";
}

<section class="wedding-hero" style="height: 100vh;">

   
    <div class="hero-content">

        <span class="hero-subtitle">Vi ska gifta oss</span>

        <h1>Hasse <span>&</span> Sara</h1>
        
        <p class="hero-date">20 juni 2027</p>

        <p class="hero-text">
            En dag fylld av kärlek, glädje och vackra minnen.
            Vi ser fram emot att fira vår stora dag tillsammans med er.
        </p>

        <div class="hero-buttons">
            <a asp-page="/Gallery" class="hero-button">
                Se vårt galleri
            </a>

            <a asp-page="/RSVP" class="hero-button hero-button-outline">
                Skicka OSA
            </a>
        </div>

    </div>
    

</section>
